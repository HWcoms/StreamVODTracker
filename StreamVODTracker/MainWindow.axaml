<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:StreamVODTracker"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        x:Class="StreamVODTracker.MainWindow"
        Title="VOD Tracker" Width="1280" Height="820" MinWidth="980" MinHeight="640"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Icon>
        <WindowIcon>/Assets/app-icon.ico</WindowIcon>
    </Window.Icon>
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F6FA" />
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#171923" />
        <SolidColorBrush x:Key="MainSurfaceBrush" Color="White" />
        <SolidColorBrush x:Key="InsetSurfaceBrush" Color="#F7F7FA" />
        <SolidColorBrush x:Key="CardSurfaceBrush" Color="White" />
        <SolidColorBrush x:Key="MainBorderBrush" Color="#E8E9EF" />
        <SolidColorBrush x:Key="SoftBorderBrush" Color="#E5E6ED" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#202230" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#777B8B" />
        <SolidColorBrush x:Key="CardTitleBrush" Color="#292B3A" />
        <SolidColorBrush x:Key="LicenseSurfaceBrush" Color="#F4F1FF" />
        <SolidColorBrush x:Key="LicenseBorderBrush" Color="#DDD6FF" />
        <SolidColorBrush x:Key="LicenseTitleBrush" Color="#4934A6" />
        <SolidColorBrush x:Key="LicenseBodyBrush" Color="#55596A" />
        <SolidColorBrush x:Key="ThemeButtonBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ThemeButtonForegroundBrush" Color="#252836" />
    </Window.Resources>
    <Window.Styles>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="14" />
            <Setter Property="MinWidth" Value="14" />
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="14" />
            <Setter Property="MinHeight" Value="14" />
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb">
            <Setter Property="MinHeight" Value="48" />
        </Style>
        <Style Selector="ScrollBar:horizontal /template/ Thumb">
            <Setter Property="MinWidth" Value="48" />
        </Style>
    </Window.Styles>
    <Grid ColumnDefinitions="240,*">
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" Padding="20,24">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,34">
                    <Border Width="38" Height="38" CornerRadius="12" Background="#7C5CFC">
                        <TextBlock Text="V" Foreground="White" FontSize="21" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="VOD TRACKER" Foreground="White" FontSize="14" FontWeight="Bold" />
                        <TextBlock Text="PERSONAL LIBRARY" Foreground="#85899B" FontSize="10" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="내 라이브러리" Foreground="#85899B" FontSize="11"
                           FontWeight="Bold" Margin="4,0,0,10" />
                <StackPanel Grid.Row="2" Spacing="6">
                    <Button Classes="nav" Tag="all" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="⌂"/><TextBlock Text="전체 보관함"/></StackPanel>
                    </Button>
                    <Button Classes="nav" Tag="chzzk" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="◉"/><TextBlock Text="치지직"/></StackPanel>
                    </Button>
                    <Button Classes="nav" Tag="soop" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="◉"/><TextBlock Text="SOOP"/></StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="3" BorderBrush="#303342" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                    <StackPanel Spacing="8">
                    <Button Content="⚙  플랫폼 API 설정" Classes="nav" Click="OpenSettings_Click" />
                        <TextBlock Text="서버 연결" Foreground="#85899B" FontSize="11" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="#E3A94B" VerticalAlignment="Center" />
                            <TextBlock Text="로컬 데이터베이스 준비 중" Foreground="#D2D4DC" FontSize="11" />
                        </StackPanel>
                        <Border BorderBrush="#303342" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                            <Button Classes="nav" Tag="licenses" Click="Navigation_Click">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="ⓘ" />
                                    <TextBlock Text="라이선스 및 오픈소스 고지" />
                                </StackPanel>
                            </Button>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="34,28,34,28">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24">
                <StackPanel Spacing="5">
                    <TextBlock x:Name="PageTitle" Text="치지직" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock x:Name="PageDescription" Text="치지직 채널과 영상을 관리하세요." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="CSV 가져오기" Height="40" Click="ImportCsv_Click" />
                    <Button Content="CSV 내보내기" Height="40" Click="ExportCsv_Click" />
                    <Button Content="Excel 내보내기" Height="40" Click="ExportXlsx_Click" />
                    <Button x:Name="ThemeToggleButton" Content="☀" Width="40" Height="40" Padding="0"
                            Background="{DynamicResource ThemeButtonBackgroundBrush}"
                            Foreground="{DynamicResource ThemeButtonForegroundBrush}"
                            BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="1"
                            CornerRadius="10" FontSize="24"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Click="ThemeToggle_Click"
                            ToolTip.Tip="다크 모드로 전환" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource MainSurfaceBrush}" CornerRadius="16" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="1" Padding="22">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TabControl x:Name="PlatformTabs" SelectionChanged="PlatformTabs_SelectionChanged" IsVisible="False" Height="0">
                        <TabItem Header="치지직" Tag="chzzk" />
                        <TabItem Header="SOOP" Tag="soop" />
                    </TabControl>

                    <Grid Grid.Row="1" x:Name="SearchFiltersPanel" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" Margin="0,18,0,18">
                        <TextBox x:Name="SearchBox" PlaceholderText="영상 제목 혹은 날짜 검색" MinHeight="38" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
                        <ComboBox Grid.Column="1" x:Name="StatusFilter" SelectedIndex="0" MinWidth="128" VerticalContentAlignment="Center" SelectionChanged="StatusFilter_SelectionChanged">
                            <ComboBoxItem Content="모든 시청 상태" />
                            <ComboBoxItem Content="미시청" />
                            <ComboBoxItem Content="시청중" />
                            <ComboBoxItem Content="시청완료" />
                        </ComboBox>
                        <ComboBox Grid.Column="2" x:Name="SortOrder" SelectedIndex="0" MinWidth="128" VerticalContentAlignment="Center" SelectionChanged="SortOrder_SelectionChanged">
                            <ComboBoxItem Content="방송일순" />
                            <ComboBoxItem Content="최근 추가순" />
                            <ComboBoxItem Content="제목순" />
                        </ComboBox>
                        <Button Grid.Column="3" x:Name="SortDirectionButton" Content="↓" Width="40" Height="40" Padding="0"
                                FontSize="22" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Click="SortDirectionButton_Click" ToolTip.Tip="내림차순" />
                    </Grid>

                    <Grid Grid.Row="2" x:Name="LibraryPanel" ColumnDefinitions="230,*" ColumnSpacing="22">
                        <Border Background="{DynamicResource InsetSurfaceBrush}" CornerRadius="12" Padding="16">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                    <TextBlock Text="채널" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="채널 추가" MinWidth="82" Height="32" Padding="8,4" Click="AddChannel_Click" ToolTip.Tip="채널 ID 또는 주소로 채널 추가" />
                                </Grid>
                                <TextBlock Grid.Row="1" Text="치지직과 SOOP 채널을 추가하면 여기에 목록이 표시됩니다." TextWrapping="Wrap" FontSize="12" Foreground="#898D9B" Margin="0,0,0,12" />
                                <Grid Grid.Row="2">
                                    <Border x:Name="ChannelEmptyState" BorderBrush="#E4E5EB" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                        <TextBlock Text="등록된 채널이 없습니다." FontSize="12" Foreground="#A0A3AF" />
                                    </Border>
                                    <ScrollViewer x:Name="ChannelScroller" IsVisible="False">
                                        <ItemsControl x:Name="ChannelCards">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:ChannelEntry">
                                                            <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="{Binding CardBorderThickness}" CornerRadius="9"
                                                            Padding="11" Margin="0,0,0,8" PointerPressed="ChannelCard_PointerPressed">
                                                        <Grid ColumnDefinitions="58,*" ColumnSpacing="10">
                                                            <Border Width="54" Height="54" CornerRadius="27" BorderThickness="3"
                                                                    BorderBrush="{Binding AvatarBorderBrush}" Padding="3"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Border Width="42" Height="42" CornerRadius="21" ClipToBounds="True" Background="#F0EDFF">
                                                                    <Grid>
                                                                        <TextBlock Text="{Binding Initial}" Foreground="#684ED8" FontSize="16"
                                                                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        <Image Source="{Binding ProfileImage}" Stretch="Uniform"
                                                                               IsVisible="{Binding HasProfileImage}"
                                                                               PointerPressed="ChannelAvatar_PointerPressed" />
                                                                    </Grid>
                                                                </Border>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Platform}" FontSize="9" Foreground="#7156E8" />
                                                                </Grid>
                                                                <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                                                                           TextWrapping="Wrap" MaxLines="3" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>

                            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                <StackPanel Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock x:Name="ListTitle" Text="다시보기 리스트" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock x:Name="ListTotalCountText" Text="총 0개" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <TextBlock x:Name="UnwatchedCountText" Text="0" FontSize="12" FontWeight="Bold" Foreground="#D84040" VerticalAlignment="Center" ToolTip.Tip="미시청" />
                                            <TextBlock Text="/" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="WatchingCountText" Text="0" FontSize="12" FontWeight="Bold" Foreground="#D99B18" VerticalAlignment="Center" ToolTip.Tip="시청중" />
                                            <TextBlock Text="/" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="CompletedCountText" Text="0" FontSize="12" FontWeight="Bold" Foreground="#2E9B57" VerticalAlignment="Center" ToolTip.Tip="시청완료" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="플랫폼별 등록 영상을 카드로 모아 보여줍니다." FontSize="11" Foreground="#898D9B" />
                                </StackPanel>
                                <StackPanel x:Name="ChannelActionBar" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="False">
                                    <Button x:Name="DeleteSelectedButton" Content="🗑 삭제" Height="42" Padding="12,8"
                                            IsVisible="False" Click="DeleteSelected_Click" ToolTip.Tip="선택한 영상 삭제" />
                                    <Button x:Name="EditSelectedButton" Content="✎ 수정" Height="42" Padding="12,8"
                                            IsVisible="False" IsEnabled="False" Click="EditSelected_Click" ToolTip.Tip="영상 한 개를 선택해 수정" />
                                    <Button x:Name="ThumbnailViewButton" Width="42" Height="42" Padding="0" Classes="primary"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            Click="ThumbnailView_Click" IsVisible="False" ToolTip.Tip="썸네일 표시 전환">
                                        <Border Width="26" Height="21" BorderBrush="White" BorderThickness="1.5" CornerRadius="2">
                                            <Grid>
                                                <Ellipse Width="5" Height="5" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" />
                                                <Polyline Points="2,17 8,10 12,14 16,9 23,17" Stroke="White" StrokeThickness="1.8" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                    <Button x:Name="GridViewButton" Width="42" Height="42" Padding="0" Classes="primary"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            Click="GridView_Click" IsVisible="False" ToolTip.Tip="그리드 보기">
                                        <Grid Width="25" Height="25" ColumnDefinitions="7,7,7" RowDefinitions="7,7,7" ColumnSpacing="2" RowSpacing="2">
                                            <Border Background="White" CornerRadius="1" />
                                            <Border Grid.Column="1" Background="White" CornerRadius="1" />
                                            <Border Grid.Column="2" Background="White" CornerRadius="1" />
                                            <Border Grid.Row="1" Background="White" CornerRadius="1" />
                                            <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="1" />
                                            <Border Grid.Row="1" Grid.Column="2" Background="White" CornerRadius="1" />
                                            <Border Grid.Row="2" Background="White" CornerRadius="1" />
                                            <Border Grid.Row="2" Grid.Column="1" Background="White" CornerRadius="1" />
                                            <Border Grid.Row="2" Grid.Column="2" Background="White" CornerRadius="1" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="ListViewButton" Width="42" Height="42" Padding="0" Classes="primary"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            Click="ListView_Click" IsVisible="False" ToolTip.Tip="리스트 보기">
                                        <Grid Width="26" Height="24" ColumnDefinitions="7,16" RowDefinitions="6,6,6" ColumnSpacing="3" RowSpacing="3">
                                            <Border Background="White" CornerRadius="1" />
                                            <Border Grid.Column="1" Height="2" Background="White" CornerRadius="1" VerticalAlignment="Center" />
                                            <Border Grid.Row="1" Background="White" CornerRadius="1" />
                                            <Border Grid.Row="1" Grid.Column="1" Height="2" Background="White" CornerRadius="1" VerticalAlignment="Center" />
                                            <Border Grid.Row="2" Background="White" CornerRadius="1" />
                                            <Border Grid.Row="2" Grid.Column="1" Height="2" Background="White" CornerRadius="1" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="DirectAddButton" Content="＋ 추가" MinWidth="82" Height="42" Padding="14,8" Classes="primary" Click="DirectAddChannelVideo_Click" IsVisible="False" ToolTip.Tip="다시보기 직접 추가" />
                                    <Button x:Name="RefreshChannelButton" Width="42" Height="42" Padding="0" Classes="primary"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            Click="RefreshChannelVideos_Click" IsVisible="False" ToolTip.Tip="새로고침">
                                        <TextBlock Text="⟳" FontSize="25" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="0,-3,0,0" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="CardsArea" Grid.Row="1" Focusable="True" IsTabStop="True" KeyDown="CardsArea_KeyDown">
                            <Border x:Name="EmptyState" BorderBrush="#ECECF1" BorderThickness="0,1,0,0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="340">
                                    <Border Width="56" Height="56" CornerRadius="18" Background="#F0EDFF" HorizontalAlignment="Center">
                                        <TextBlock Text="▤" FontSize="25" Foreground="#7C5CFC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                            <TextBlock x:Name="EmptyStateTitle" Text="채널을 추가하거나 선택해주세요" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="EmptyStateDescription" Text="왼쪽 채널 목록에서 채널을 선택하거나 새 채널을 추가해 주세요."
                                               FontSize="12" Foreground="#85899B" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" />
                                    <Button x:Name="EmptyStateAddButton" Content="＋  영상 추가하기" Classes="primary" Margin="0,6,0,0" Click="AddMenu_Click" />
                                    <StackPanel x:Name="ChannelEmptyActions" Orientation="Horizontal" Spacing="10" IsVisible="False" HorizontalAlignment="Center">
                                        <Button Content="새로고침" Click="RefreshChannelVideos_Click" />
                                        <Button Content="직접추가" Classes="primary" Click="DirectAddChannelVideo_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <ScrollViewer x:Name="CardsScroller" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="CardsList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:MediaCard">
                                            <Border Width="{Binding CardWidth}" MinHeight="{Binding CardMinHeight}" Margin="0,16,16,0" Padding="15"
                                                    Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="{Binding CardBorderThickness}" CornerRadius="13"
                                                    Tag="grid" Loaded="MediaCard_Loaded" Unloaded="MediaCard_Unloaded" PointerPressed="MediaCard_PointerPressed">
                                                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowSpacing="9">
                                                    <Border Height="142" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource InsetSurfaceBrush}"
                                                            IsVisible="{Binding ShowThumbnails}">
                                                        <Grid>
                                                            <TextBlock Text="?" FontSize="30" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       IsVisible="{Binding ShowThumbnailPlaceholder}" />
                                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource CardTitleBrush}"
                                                               TextTrimming="CharacterEllipsis" MaxLines="2" />
                                                    <TextBlock Grid.Row="2" Text="{Binding SourceLabel}" FontSize="11" Foreground="#85899B" TextTrimming="CharacterEllipsis"
                                                               TextDecorations="Underline" Cursor="Hand" VerticalAlignment="Top" PointerPressed="MediaSource_PointerPressed" />
                                                    <TextBlock Grid.Row="3" Text="{Binding LocalFilePathLabel}" IsVisible="{Binding HasLocalFilePath}"
                                                               FontSize="11" Foreground="#7156E8" TextTrimming="CharacterEllipsis" TextDecorations="Underline"
                                                               Cursor="Hand" ToolTip.Tip="로컬 파일 열기" PointerPressed="MediaFile_PointerPressed" />
                                                    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding IsLastPositionVisible}">
                                                                    <TextBlock Text="시청 위치:" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                                    <TextBox Width="20" MinWidth="0" Height="18" MinHeight="0" Padding="0" FontSize="10" BorderBrush="#555963" BorderThickness="1" VerticalContentAlignment="Center" MaxLength="2" Tag="hours" Text="{Binding LastPositionHours}" TextChanged="LastPositionInput_TextChanged" TextInput="LastPositionInput_TextInput" GotFocus="LastPositionInput_GotFocus" LostFocus="LastPositionInput_LostFocus" />
                                                                    <TextBlock Text=":" VerticalAlignment="Center" />
                                                                    <TextBox Width="20" MinWidth="0" Height="18" MinHeight="0" Padding="0" FontSize="10" BorderBrush="#555963" BorderThickness="1" VerticalContentAlignment="Center" MaxLength="2" Tag="minutes" Text="{Binding LastPositionMinutes}" TextChanged="LastPositionInput_TextChanged" TextInput="LastPositionInput_TextInput" GotFocus="LastPositionInput_GotFocus" LostFocus="LastPositionInput_LostFocus" />
                                                                    <TextBlock Text=":" VerticalAlignment="Center" />
                                                                    <TextBox Width="20" MinWidth="0" Height="18" MinHeight="0" Padding="0" FontSize="10" BorderBrush="#555963" BorderThickness="1" VerticalContentAlignment="Center" MaxLength="2" Tag="seconds" Text="{Binding LastPositionRemainderSeconds}" TextChanged="LastPositionInput_TextChanged" TextInput="LastPositionInput_TextInput" GotFocus="LastPositionInput_GotFocus" LostFocus="LastPositionInput_LostFocus" />
                                                                </StackPanel>
                                                                <TextBlock Text="/" IsVisible="{Binding IsLastPositionVisible}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                                <TextBlock Text="{Binding DurationLabel}" ToolTip.Tip="영상 시간" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding PublishedAtLabel}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="{Binding WatchStatusLabel}" Background="{Binding WatchStatusBackground}" Foreground="{Binding WatchStatusForeground}"
                                                                BorderThickness="0" CornerRadius="8" Padding="10,6" FontSize="13" FontWeight="SemiBold"
                                                                Click="WatchStatus_Click" />
                                                    </Grid>
                                                    <Grid Classes="playback-progress" Grid.Row="5" Height="20" Background="Transparent" IsVisible="{Binding IsLastPositionVisible}"
                                                          Cursor="Hand" Focusable="True"
                                                          PointerEntered="PlaybackProgress_PointerEntered" PointerExited="PlaybackProgress_PointerExited"
                                                          PointerPressed="PlaybackPositionSlider_PointerPressed" PointerMoved="PlaybackPositionSlider_PointerMoved" PointerReleased="PlaybackPositionSlider_PointerReleased"
                                                          KeyDown="PlaybackPositionSlider_KeyDown" KeyUp="PlaybackPositionSlider_KeyUp">
                                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding PlaybackProgressRatio}" Height="{Binding PlaybackProgressBarHeight}"
                                                                     VerticalAlignment="Center" Background="#C9CBD3" Foreground="{Binding PlaybackAccentBrush}"
                                                                     IsHitTestVisible="False" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <ScrollViewer x:Name="CardsListScroller" IsVisible="False" HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="CardsListRows" Margin="0,0,18,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:MediaCard">
                                        <Border HorizontalAlignment="Stretch" MinHeight="122" Margin="0,10,0,0" Padding="14"
                                                Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="{Binding CardBorderThickness}" CornerRadius="13"
                                                Tag="list" Loaded="MediaCard_Loaded" Unloaded="MediaCard_Unloaded" PointerPressed="MediaCard_PointerPressed">
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="16">
                                                <Border Grid.Column="0" Width="160" Height="94" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource InsetSurfaceBrush}"
                                                        IsVisible="{Binding ShowThumbnails}">
                                                    <Grid>
                                                        <TextBlock Text="?" FontSize="26" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   IsVisible="{Binding ShowThumbnailPlaceholder}" />
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                                                    </Grid>
                                                </Border>
                                                <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="7">
                                                    <StackPanel Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource CardTitleBrush}"
                                                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                        <TextBlock Text="{Binding SourceLabel}" FontSize="11" Foreground="#85899B" TextTrimming="CharacterEllipsis"
                                                                   TextDecorations="Underline" Cursor="Hand" PointerPressed="MediaSource_PointerPressed" />
                                                        <TextBlock Text="{Binding LocalFilePathLabel}" IsVisible="{Binding HasLocalFilePath}"
                                                                   FontSize="11" Foreground="#7156E8" TextTrimming="CharacterEllipsis" TextDecorations="Underline"
                                                                   Cursor="Hand" ToolTip.Tip="로컬 파일 열기" PointerPressed="MediaFile_PointerPressed" />
                                                    </StackPanel>
                                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding IsLastPositionVisible}">
                                                                <TextBlock Text="시청 위치:" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                                <TextBox Width="20" MinWidth="0" Height="18" MinHeight="0" Padding="0" FontSize="10" BorderBrush="#555963" BorderThickness="1" VerticalContentAlignment="Center" MaxLength="2" Tag="hours" Text="{Binding LastPositionHours}" TextChanged="LastPositionInput_TextChanged" TextInput="LastPositionInput_TextInput" GotFocus="LastPositionInput_GotFocus" LostFocus="LastPositionInput_LostFocus" />
                                                                <TextBlock Text=":" VerticalAlignment="Center" />
                                                                <TextBox Width="20" MinWidth="0" Height="18" MinHeight="0" Padding="0" FontSize="10" BorderBrush="#555963" BorderThickness="1" VerticalContentAlignment="Center" MaxLength="2" Tag="minutes" Text="{Binding LastPositionMinutes}" TextChanged="LastPositionInput_TextChanged" TextInput="LastPositionInput_TextInput" GotFocus="LastPositionInput_GotFocus" LostFocus="LastPositionInput_LostFocus" />
                                                                <TextBlock Text=":" VerticalAlignment="Center" />
                                                                <TextBox Width="20" MinWidth="0" Height="18" MinHeight="0" Padding="0" FontSize="10" BorderBrush="#555963" BorderThickness="1" VerticalContentAlignment="Center" MaxLength="2" Tag="seconds" Text="{Binding LastPositionRemainderSeconds}" TextChanged="LastPositionInput_TextChanged" TextInput="LastPositionInput_TextInput" GotFocus="LastPositionInput_GotFocus" LostFocus="LastPositionInput_LostFocus" />
                                                            </StackPanel>
                                                            <TextBlock Text="/" IsVisible="{Binding IsLastPositionVisible}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                            <TextBlock Text="{Binding DurationLabel}" ToolTip.Tip="영상 시간" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                            <TextBlock Text="{Binding PublishedAtLabel}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="{Binding WatchStatusLabel}" Background="{Binding WatchStatusBackground}" Foreground="{Binding WatchStatusForeground}"
                                                                BorderThickness="0" CornerRadius="8" Padding="10,6" FontSize="13" FontWeight="SemiBold"
                                                                Click="WatchStatus_Click" />
                                                    </Grid>
                                                </Grid>
                                                <Grid Classes="playback-progress" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0" Height="20" Background="Transparent" IsVisible="{Binding IsLastPositionVisible}"
                                                      Cursor="Hand" Focusable="True"
                                                      PointerEntered="PlaybackProgress_PointerEntered" PointerExited="PlaybackProgress_PointerExited"
                                                      PointerPressed="PlaybackPositionSlider_PointerPressed" PointerMoved="PlaybackPositionSlider_PointerMoved" PointerReleased="PlaybackPositionSlider_PointerReleased"
                                                      KeyDown="PlaybackPositionSlider_KeyDown" KeyUp="PlaybackPositionSlider_KeyUp">
                                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding PlaybackProgressRatio}" Height="{Binding PlaybackProgressBarHeight}"
                                                                 VerticalAlignment="Center" Background="#C9CBD3" Foreground="{Binding PlaybackAccentBrush}"
                                                                 IsHitTestVisible="False" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Canvas x:Name="SelectionOverlay" IsHitTestVisible="False" ClipToBounds="True">
                                <Border x:Name="SelectionRectangle" IsVisible="False" BorderBrush="#35B879" BorderThickness="1.5"
                                        Background="#5535B879" CornerRadius="3" />
                            </Canvas>
                            </Grid>
                        </Grid>
                    </Grid>
                            <ScrollViewer x:Name="LicensePanel" Grid.Row="2" IsVisible="False" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="14" Margin="4">
                                    <TextBlock Text="라이선스 및 코드 참조" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <Border Background="{DynamicResource LicenseSurfaceBrush}" BorderBrush="{DynamicResource LicenseBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="VODTracker는 MIT 라이선스로 배포됩니다." FontSize="15" FontWeight="Bold" Foreground="{DynamicResource LicenseTitleBrush}" />
                                            <TextBlock Text="Copyright (c) 2026 VODTracker contributors" FontSize="11" Foreground="#777B8B" />
                                            <TextBlock Text="Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the &quot;Software&quot;), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions: The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software. THE SOFTWARE IS PROVIDED &quot;AS IS&quot;, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource LicenseBodyBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="참고 프로젝트와 제작자 링크를 함께 표시합니다. 패키지별 고지와 라이선스 세부사항은 THIRD-PARTY-LICENSES.md를 확인하세요." TextWrapping="Wrap" FontSize="12" Foreground="#777B8B" />
                                    <ItemsControl x:Name="LicenseEntries">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:LicenseEntry">
                                                <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="{Binding ProjectName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" FontSize="11" FontWeight="Bold" Foreground="#A46A17" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding LicenseLabel}" FontSize="12" Foreground="#684ED8" />
                                                        <TextBlock Text="{Binding UsageNote}" TextWrapping="Wrap" FontSize="11" Foreground="#777B8B" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Button Content="프로젝트" Tag="{Binding ProjectUrl}" Click="OpenLicenseReference_Click" />
                                                            <Button Content="{Binding CreatorLinkLabel}" Tag="{Binding CreatorUrl}" Click="OpenLicenseReference_Click" />
                                                            <Button Content="라이선스" Tag="{Binding LicenseUrl}" IsVisible="{Binding HasLicenseUrl}" Click="OpenLicenseReference_Click" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C4C6D0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="#252836" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#7156E8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#6045D4" />
        </Style>
    </Window.Styles>
</Window>
